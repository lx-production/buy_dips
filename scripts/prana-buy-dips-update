#!/usr/bin/env bash

# Safely update the Pi production checkout and restore the prod live timer.
set -Eeuo pipefail
umask 0077

readonly REPO_DIR="/home/botuser/buy_dips"
readonly BOT_USER="botuser"
readonly BOT_GROUP="botuser"
readonly CONFIG_PATH="${REPO_DIR}/config.prod.yaml"
readonly DB_PATH="${REPO_DIR}/data/canary.sqlite"
readonly PAUSE_FILE="${REPO_DIR}/data/PAUSE_TRADING"
readonly BACKUP_DIR="${REPO_DIR}/data/backups"
readonly INSTALLED_SCRIPT="/usr/local/sbin/prana-buy-dips-update"
readonly WAIT_TIMEOUT_SECONDS=900
readonly LIVE_TIMER="prana-buy-dips-prod-live.timer"
readonly LIVE_SERVICE="prana-buy-dips-prod-live.service"
readonly -a LEGACY_TIMERS=(
  "prana-buy-dips@observe.timer"
  "prana-buy-dips@dry_run.timer"
  "prana-buy-dips@live.timer"
)
readonly -a LEGACY_SERVICES=(
  "prana-buy-dips@observe.service"
  "prana-buy-dips@dry_run.service"
  "prana-buy-dips@live.service"
)

live_timer_state=""
permissions_unlocked=0

# Print one timestamped deployment message.
log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" "$*"
}

# Stop immediately unless the script is running as root through sudo.
require_root() {
  if (( EUID != 0 )); then
    printf 'Run this updater with sudo: sudo %s\n' "${INSTALLED_SCRIPT}" >&2
    exit 1
  fi
}

# Confirm the production checkout, config, and database exist before changing system state.
validate_environment() {
  local command_name

  for command_name in flock git install journalctl runuser sha256sum sqlite3 systemctl; do
    if ! command -v "${command_name}" >/dev/null 2>&1; then
      printf 'Required command is missing: %s\n' "${command_name}" >&2
      exit 1
    fi
  done

  if [[ ! -d "${REPO_DIR}/.git" ]]; then
    printf 'Git checkout not found: %s\n' "${REPO_DIR}" >&2
    exit 1
  fi
  if [[ ! -x "${REPO_DIR}/.venv/bin/python" ]]; then
    printf 'Virtualenv Python is missing or not executable: %s\n' "${REPO_DIR}/.venv/bin/python" >&2
    exit 1
  fi
  if [[ ! -f "${CONFIG_PATH}" ]]; then
    printf 'Production config not found: %s\n' "${CONFIG_PATH}" >&2
    exit 1
  fi
  if [[ ! -f "${DB_PATH}" ]]; then
    printf 'Production database not found: %s\n' "${DB_PATH}" >&2
    exit 1
  fi
}

# Refuse overlapping updater runs so ownership and timer restoration cannot race.
acquire_deploy_lock() {
  exec 9>"/run/lock/prana-buy-dips-update.lock"
  if ! flock -n 9; then
    printf 'Another prana-buy-dips update is already running.\n' >&2
    exit 1
  fi
}

# Return success when a unit is enabled persistently or for this boot only.
timer_is_enabled() {
  local state="$1"

  [[ "${state}" == "enabled" || "${state}" == "enabled-runtime" ]]
}

# Refuse while an old canary unit is still enabled or running, without stopping it.
refuse_legacy_units() {
  local service
  local state
  local timer

  for timer in "${LEGACY_TIMERS[@]}"; do
    state="$(systemctl is-enabled "${timer}" 2>/dev/null || true)"
    if timer_is_enabled "${state}" || systemctl is-active --quiet "${timer}"; then
      printf 'Legacy timer %s is enabled or active. Disable it manually before updating production.\n' "${timer}" >&2
      exit 1
    fi
  done

  for service in "${LEGACY_SERVICES[@]}"; do
    if systemctl is-active --quiet "${service}"; then
      printf 'Legacy service %s is still running. Let it finish, then update production.\n' "${service}" >&2
      exit 1
    fi
  done
}

# Remember whether the production live timer should be turned back on after deploy.
detect_timer_state() {
  refuse_legacy_units
  live_timer_state="$(systemctl is-enabled "${LIVE_TIMER}" 2>/dev/null || true)"
}

# Disable the production live timer so a new hour cannot start mid-deploy.
stop_live_timer() {
  if timer_is_enabled "${live_timer_state}"; then
    log "Disabling ${LIVE_TIMER} during deployment"
    if [[ "${live_timer_state}" == "enabled-runtime" ]]; then
      systemctl disable --runtime --now "${LIVE_TIMER}"
    else
      systemctl disable --now "${LIVE_TIMER}"
    fi
  elif systemctl is-active --quiet "${LIVE_TIMER}"; then
    log "Stopping manually started ${LIVE_TIMER} during deployment"
    systemctl stop "${LIVE_TIMER}"
  fi
}

# Wait for the production oneshot to finish instead of terminating it during a DB write.
wait_for_live_service() {
  local started_at="${SECONDS}"

  while systemctl is-active --quiet "${LIVE_SERVICE}"; do
    if (( SECONDS - started_at >= WAIT_TIMEOUT_SECONDS )); then
      printf '%s is still active after %s seconds; timer remains disabled.\n' "${LIVE_SERVICE}" "${WAIT_TIMEOUT_SECONDS}" >&2
      exit 1
    fi

    log "Waiting for ${LIVE_SERVICE} to finish safely"
    sleep 2
  done
}

# Create a consistent, timestamped SQLite backup and verify that it can be read.
backup_database() {
  local backup_path
  local quick_check
  local timestamp

  timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
  backup_path="${BACKUP_DIR}/canary-before-update-${timestamp}.sqlite"
  runuser -u "${BOT_USER}" -- mkdir -p "${BACKUP_DIR}"
  runuser -u "${BOT_USER}" -- sqlite3 "${DB_PATH}" ".backup '${backup_path}'"
  quick_check="$(runuser -u "${BOT_USER}" -- sqlite3 "${backup_path}" 'PRAGMA quick_check;')"
  if [[ "${quick_check}" != "ok" ]]; then
    printf 'SQLite backup verification failed: %s\n' "${backup_path}" >&2
    exit 1
  fi
  log "Verified database backup ${backup_path}"
}

# Reject tracked local edits because an automated deploy must not merge or overwrite them.
require_clean_tracked_files() {
  if ! git -c "safe.directory=${REPO_DIR}" -C "${REPO_DIR}" diff --quiet --ignore-submodules -- || ! git -c "safe.directory=${REPO_DIR}" -C "${REPO_DIR}" diff --cached --quiet --ignore-submodules --; then
    printf 'Tracked local changes exist in %s; deployment stopped before pull.\n' "${REPO_DIR}" >&2
    exit 1
  fi
}

# Temporarily let the unprivileged deploy user update Git and the virtualenv.
unlock_repo_permissions() {
  chown -R "${BOT_USER}:${BOT_GROUP}" "${REPO_DIR}"
  permissions_unlocked=1
}

# Restore runtime ownership: code is root-owned/read-only, while data remains writable.
lock_repo_permissions() {
  local failed=0

  chown -R "root:${BOT_GROUP}" "${REPO_DIR}" || failed=1
  find "${REPO_DIR}" -type d -exec chmod 0750 {} + || failed=1
  find "${REPO_DIR}" -type f -exec chmod 0640 {} + || failed=1
  find "${REPO_DIR}/.venv/bin" -type f -exec chmod 0750 {} + || failed=1

  chown -R "${BOT_USER}:${BOT_GROUP}" "${REPO_DIR}/data" || failed=1
  chmod 0700 "${REPO_DIR}/data" || failed=1
  chmod 0700 "${REPO_DIR}/data/wallet" || failed=1
  chmod 0700 "${REPO_DIR}/data/logs" || failed=1
  find "${REPO_DIR}/data/wallet" -maxdepth 1 -type f -exec chmod 0600 {} + || failed=1
  chmod 0640 "${CONFIG_PATH}" || failed=1
  if [[ -f "${REPO_DIR}/config.canary.yaml" ]]; then
    chmod 0640 "${REPO_DIR}/config.canary.yaml" || failed=1
  fi

  return "${failed}"
}

# Pull only a fast-forward update and install changed dependencies. Suite tests stay on dev.
update_and_test() {
  local new_commit
  local old_commit
  local requirements_after
  local requirements_before

  old_commit="$(git -c "safe.directory=${REPO_DIR}" -C "${REPO_DIR}" rev-parse --short HEAD)"
  requirements_before="$(sha256sum "${REPO_DIR}/requirements.txt" | cut -d ' ' -f 1)"

  runuser -u "${BOT_USER}" -- env HOME="/home/${BOT_USER}" git -C "${REPO_DIR}" pull --ff-only

  requirements_after="$(sha256sum "${REPO_DIR}/requirements.txt" | cut -d ' ' -f 1)"
  if [[ "${requirements_before}" != "${requirements_after}" ]]; then
    log "requirements.txt changed; synchronizing the virtualenv"
    runuser -u "${BOT_USER}" -- "${REPO_DIR}/.venv/bin/python" -m pip install -r "${REPO_DIR}/requirements.txt"
  else
    log "requirements.txt unchanged; keeping the existing virtualenv"
  fi

  new_commit="$(git -c "safe.directory=${REPO_DIR}" -C "${REPO_DIR}" rev-parse --short HEAD)"
  log "Updated code ${old_commit} -> ${new_commit}"
}

# Atomically refresh the root-owned command for the next deployment.
install_latest_updater() {
  local source_path="${REPO_DIR}/scripts/prana-buy-dips-update"
  local temporary_path="${INSTALLED_SCRIPT}.new"

  install -o root -g root -m 0750 "${source_path}" "${temporary_path}"
  mv -f "${temporary_path}" "${INSTALLED_SCRIPT}"
}

# Run one production cycle only while the pause file blocks signing.
verify_live_cycle() {
  if [[ ! -f "${PAUSE_FILE}" ]]; then
    log "Pause file is absent; not starting ${LIVE_SERVICE}. The restored timer runs the next cycle."
    return
  fi

  log "Running one paused ${LIVE_SERVICE} cycle with the updated code"
  systemctl start "${LIVE_SERVICE}"
  journalctl -u "${LIVE_SERVICE}" -n 15 --no-pager
}

# Re-enable the production live timer only when this deploy stopped an enabled one.
restore_timer() {
  if ! timer_is_enabled "${live_timer_state}"; then
    log "${LIVE_TIMER} was not enabled before deployment; leaving it disabled"
    return
  fi

  if [[ "${live_timer_state}" == "enabled-runtime" ]]; then
    systemctl enable --runtime --now "${LIVE_TIMER}"
  else
    systemctl enable --now "${LIVE_TIMER}"
  fi
  log "Restored ${LIVE_TIMER}"
}

# Re-lock the checkout after failures and deliberately leave trading timers disabled.
cleanup_on_exit() {
  local status="${1}"

  trap - EXIT INT TERM
  if (( status != 0 )); then
    set +e
    if (( permissions_unlocked == 1 )); then
      log "Update failed; restoring locked repository permissions"
      if lock_repo_permissions; then
        permissions_unlocked=0
      else
        printf 'CRITICAL: repository permission recovery failed; inspect %s manually.\n' "${REPO_DIR}" >&2
      fi
    fi
    printf 'Update failed. Trading timers were not restored; review the error before enabling one.\n' >&2
  fi

  exit "${status}"
}

# Execute the guarded deployment workflow in a fail-closed order.
main() {
  require_root
  validate_environment
  acquire_deploy_lock
  require_clean_tracked_files
  detect_timer_state
  trap 'cleanup_on_exit "$?"' EXIT INT TERM

  stop_live_timer
  wait_for_live_service
  backup_database
  unlock_repo_permissions
  update_and_test

  log "Restoring locked repository permissions"
  lock_repo_permissions
  permissions_unlocked=0

  install_latest_updater
  verify_live_cycle
  restore_timer
  log "Deployment completed successfully"
}

main "$@"
